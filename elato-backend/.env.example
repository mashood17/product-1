# Documents every environment variable the backend needs — never commit real values.
ENV=development
PORT=8000

# Generate fresh — do not reuse Supabase's own JWT secret.
JWT_SECRET=

# Optional — override the access/refresh token lifetimes (minutes/days).
# Defaults below match app/core/config.py.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# From the Supabase project dashboard (Settings -> API). SUPABASE_SECRET_KEY
# is the service-role key — server-only, must never reach a frontend build.
SUPABASE_URL=
SUPABASE_SECRET_KEY=


# Comma-separated, no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Admin panel origin — used to build password-reset links.
FRONTEND_ADMIN_URL=http://localhost:5174

# Optional — reviews sync is stubbed (returns empty, changes nothing in
# Supabase) until these are set.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Shared secret required in the X-Cron-Secret header to trigger
# POST /api/v1/sync/reviews. Generate a random value and set it here.
SYNC_CRON_SECRET=

# Optional — max accepted hero background video size in bytes. Defaults to
# 25MB (app/core/config.py) if unset.
HERO_VIDEO_MAX_BYTES=26214400
